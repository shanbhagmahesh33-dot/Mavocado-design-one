/* Refined menu navigation, curved stamps, and photography framing. */
.menu-controls{display:block;border:1px solid var(--line);background:#ece9de;padding:10px;margin-bottom:30px;border-radius:12px}.menu-tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;overflow:visible}.menu-tabs button{display:flex;align-items:center;justify-content:flex-start;gap:12px;min-height:65px;padding:14px 17px;border:1px solid transparent;border-radius:7px;color:var(--ink);font-size:12px;transition:background .25s,color .25s,box-shadow .25s,transform .3s var(--ease)}.menu-tabs button>svg{width:24px;height:24px;stroke-width:1.4;color:var(--red);transition:transform .3s}.menu-tabs button b{margin-left:auto;display:grid;place-items:center;min-width:26px;height:24px;padding:0 5px;background:#dedfce;font-size:10px;font-weight:500;border-radius:4px;font-variant-numeric:tabular-nums}.menu-tabs button:hover{background:#e2dfd0;transform:translateY(-1px)}.menu-tabs button:hover>svg{transform:rotate(-7deg)}.menu-tabs button.active{background:var(--green);color:var(--paper);box-shadow:0 4px 8px #263d3012}.menu-tabs button.active svg{color:var(--butter)}.menu-tabs button.active b{background:var(--butter);color:var(--ink)}.menu-tabs button.active:after{display:none}.menu-tabs button:focus-visible{outline-offset:3px}.menu-preferences{display:flex;align-items:center;justify-content:space-between;padding:17px 10px 5px;margin-top:10px;border-top:1px solid #d3d4c2;gap:20px}.menu-preferences .veg-only{font-size:11px;margin:0}.menu-preferences>span{font-size:10px;color:var(--muted)}
.gather-banner{display:grid;grid-template-columns:1fr 1fr;margin-top:46px;background:#ebe6d4;min-height:390px;overflow:hidden}.gather-image{position:relative;min-width:0;overflow:hidden}.gather-image img{height:100%;width:100%;object-fit:cover;transition:transform 1s var(--ease)}.gather-banner:hover .gather-image img{transform:scale(1.025)}.gather-image>span{position:absolute;bottom:20px;left:23px;background:var(--paper);padding:9px 11px;font-size:8px;letter-spacing:.12em}.gather-copy{padding:42px 46px;position:relative;isolation:isolate}.gather-copy h3{font-size:53px;line-height:1.03;margin-top:23px;letter-spacing:-.04em}.gather-copy h3 i{color:var(--red)}.gather-copy>p:not(.eyebrow){font-size:12px;line-height:1.9;color:var(--muted);margin-top:20px}.gather-copy>.button{margin-top:26px;gap:32px}.gather-secondary{display:flex;align-items:center;gap:13px;font-size:10px;width:max-content;margin-top:18px}.gather-secondary svg{width:16px;height:16px;transition:transform .3s}.gather-secondary:hover svg{transform:translateX(4px)}.gather-flower{position:absolute;right:-20px;bottom:9px;font-size:136px;opacity:.07;line-height:1;z-index:-1}
.story-section{padding-bottom:55px}.story-frame{height:auto;max-height:none;clip-path:none;border-radius:9px;overflow:hidden;aspect-ratio:2/3}.story-frame img{height:100%;width:100%;object-fit:contain;object-position:center;transform:none!important}.story-image{padding-right:25px}.story-stamp{width:184px;height:184px;right:-12px;bottom:50px;outline:none;background:var(--butter);transform:none;display:grid;place-items:center}.stamp-lettering{position:absolute;inset:0;width:100%;height:100%;overflow:visible;stroke:none;fill:none}.stamp-lettering circle{stroke:currentColor;stroke-width:.6;opacity:.4}.stamp-lettering circle:nth-of-type(2){opacity:.2}.stamp-lettering text{fill:currentColor;stroke:none;font-family:var(--sans);font-size:12px;letter-spacing:2.1px;font-weight:400}.stamp-lettering text.stamp-bottom{font-size:9px;letter-spacing:1.2px}.story-stamp strong{font-size:31px;line-height:1;letter-spacing:-.03em;margin:0;text-align:center;position:relative;top:-1px}.hero-note{display:grid;place-items:center;outline:none;animation:none;transform:none}.hero-note .note-mark{font-size:45px;margin:0}.hero-note .stamp-lettering text{font-size:10.7px;letter-spacing:1.6px}.hero-note .stamp-lettering text.stamp-bottom{font-size:10.5px;letter-spacing:1.6px}
.values-section{padding-top:0;padding-bottom:95px}.values-heading{display:flex;align-items:center;justify-content:space-between;gap:25px;margin-bottom:20px}.values-nav{display:flex;align-items:center;gap:9px}.values-nav>span{font-size:10px;color:var(--muted);margin-right:8px}.values-nav button{width:30px;height:30px;border:1px solid var(--line);border-radius:50%;background:transparent;color:var(--ink);display:none;place-items:center}.values-nav button svg{width:16px;height:16px}.values-nav button:first-of-type svg{transform:rotate(180deg)}.values-nav button:hover{background:var(--butter)}.story-values{display:flex;flex-flow:row nowrap;gap:0;justify-content:space-between;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scrollbar-width:none;margin:0;padding:30px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.story-values::-webkit-scrollbar{display:none}.story-values>.value-item{flex:1 0 0;min-width:115px;padding:0 15px;text-align:center;border-right:1px solid var(--line);scroll-snap-align:start;font-size:11px;line-height:1.7}.story-values>.value-item:first-child{padding-left:0}.story-values>.value-item:last-child{border-right:0;padding-right:0}.story-values svg{width:32px;height:32px;display:block;margin:0 auto 17px;stroke-width:1.35;color:var(--red)}
