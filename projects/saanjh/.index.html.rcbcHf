<script>const EMBEDDED_ASSETS={"paneer": "data:image/webp;base64,", "butter": "data:image/webp;base64,", "dal": "data:image/webp;base64,", "biryani": "data:image/webp;base64,", "prawns": "data:image/webp;base64,", "dessert": "data:image/webp;base64,", "tandoori": "data:image/webp;base64,", "rasmalai": "data:image/webp;base64,", "gallery-01": "data:image/webp;base64,