<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Saanjh — Indian Kitchen & Courtyard</title>
<meta name="description" content="Pull up a chair at Saanjh. An Indian kitchen imagined around slow cooking, generous tables and good company.">
<meta name="theme-color" content="#f5f1e6"><link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,">

<style>@font-face{font-family:Petrona;src:url('data:font/woff;base64,') format('woff');font-weight:400;font-style:italic;font-display:swap}@font-face{font-family:Petrona;src:url('data:font/woff;base64,') format('woff');font-weight:600;font-display:swap}@font-face{font-family:Onest;src:url('data:font/woff;base64,') format('woff');font-weight:500 900;font-display:swap}
@font-face{font-family:Petrona;src:url('data:font/woff;base64,') format('woff');font-weight:400;font-display:swap}@font-face{font-family:Onest;src:url('data:font/woff;base64,') format('woff');font-weight:400;font-display:swap}
:root{--paper:#f5f1e6;--ink:#24382b;--red:#b73c29;--green:#263d30;--muted:#6b6f5c;--line:#d8d7c6;--butter:#eeddb1;--serif:Petrona,Georgia,serif;--sans:Onest,Arial,sans-serif;--ease:cubic-bezier(.22,1,.36,1)}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:100px}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:14px;-webkit-font-smoothing:antialiased}body.modal-open{overflow:hidden}::selection{background:var(--red);color:var(--paper)}button,input,select{font:inherit}button,a{touch-action:manipulation;-webkit-tap-highlight-color:transparent}button{cursor:pointer}a{color:inherit;text-decoration:none}img{display:block;width:100%;object-fit:cover}svg{width:24px;height:24px;stroke:currentColor;stroke-width:1.5;fill:none;flex-shrink:0}h1,h2,h3,p{margin:0}h1,h2,h3{font-family:var(--serif);font-weight:400;letter-spacing:-.045em}i{font-style:italic}button:focus-visible,a:focus-visible,summary:focus-visible{outline:2px solid var(--red);outline-offset:6px}input:focus-visible,select:focus-visible{outline:0;border-color:var(--red);box-shadow:0 2px 0 var(--red)}.skip{position:fixed;top:-100px;left:20px;background:var(--paper);padding:15px;z-index:100}.skip:focus{top:12px}.sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}.svg-defs{position:absolute;width:0;height:0;overflow:hidden}.header{height:105px;padding:0 48px;display:flex;align-items:center;justify-content:space-between;gap:28px;background:var(--paper);position:sticky;top:0;z-index:30;transition:height .4s,box-shadow .4s}.header.scrolled{height:82px;box-shadow:0 1px 0 var(--line)}.brand{display:inline-flex;align-items:center;gap:6px;color:var(--red)}.brand img{width:44px;height:44px;object-fit:contain}.brand>span{font-family:var(--serif);font-size:43px;line-height:.85;letter-spacing:-.065em;font-weight:600}.brand-dot{color:var(--red)}.brand small{display:block;font-family:var(--sans);font-size:7.5px;letter-spacing:.18em;line-height:1;margin-top:12px;font-weight:500}.header nav{display:flex;gap:36px;align-items:center}.header nav a{font-size:12px;position:relative;padding:12px 0}.header nav a:after{content:'';position:absolute;bottom:5px;left:0;width:100%;height:1px;background:var(--red);transform:scaleX(0);transform-origin:right;transition:transform .35s}.header nav a:hover:after{transform:scaleX(1);transform-origin:left}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:30px;min-height:52px;padding:0 8px 0 20px;border:1px solid transparent;background:none;font-size:12px;font-weight:500;transition:background .3s,transform .4s var(--ease);position:relative}.button svg{width:37px;height:37px;padding:9px;border-left:1px solid currentColor;transition:transform .4s var(--ease)}.button:hover svg{transform:translateX(3px)}.button:hover{transform:translateY(-2px)}.button-outline{border-color:#aaa994}.button-outline:hover{background:var(--butter);border-color:var(--butter)}.button-cream{background:var(--paper);color:var(--ink)}.button-cream:hover{background:var(--butter)}.button-red{background:var(--red);color:var(--paper)}.button-red:hover{background:#983321}.mobile-toggle{display:none}.hero{height:min(720px,calc(100svh - 124px));min-height:570px;position:relative;margin:0 24px;color:var(--paper);overflow:hidden;isolation:isolate}.hero-photo,.hero-shade{position:absolute;inset:0;z-index:-1}.hero-photo{inset:-35px 0}.hero-photo img{height:100%;animation:hero-zoom 1.6s var(--ease) both;object-position:50% 55%}.hero-shade{background:linear-gradient(90deg,rgba(12,20,13,.72) 0%,rgba(12,20,13,.35) 48%,rgba(12,20,13,.04) 100%),linear-gradient(0deg,rgba(10,17,9,.48),transparent 30%)}.hero-copy{padding:83px 6%;position:relative}.eyebrow{font-size:10px;line-height:1.5;letter-spacing:.15em;font-weight:500}.eyebrow.ink{color:var(--red)}.hero .eyebrow{display:flex;align-items:center;gap:15px}.small-sun{font-size:27px;line-height:1}.hero h1{font-size:clamp(68px,7.9vw,124px);line-height:.98;letter-spacing:-.055em;margin:33px 0 26px}.hero h1 span{display:block;animation:hero-rise 1.2s var(--ease) both}.hero h1 span:nth-child(2){animation-delay:.12s}.hero h1 i{font-weight:400}.hero-description{font-size:14px;line-height:1.7;margin-bottom:28px;opacity:.95}.hero-note{position:absolute;right:5.5%;top:78px;width:132px;height:132px;background:var(--paper);color:var(--red);border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;transform:rotate(10deg);font-size:10px;line-height:1.5;outline:1px dashed rgba(245,241,230,.65);outline-offset:8px;animation:note-float 6s ease-in-out infinite}.note-mark{font-size:35px;line-height:1.1;margin-bottom:9px}.hero-bottom{position:absolute;left:6%;right:5%;bottom:25px;display:flex;align-items:center;justify-content:space-between;font-size:9px;letter-spacing:.12em}.hero-bottom a{display:flex;align-items:center;gap:18px;letter-spacing:0;font-size:11px}.hero-bottom svg{height:20px}.ribbon{border-bottom:1px solid var(--line);height:63px;display:flex;align-items:center;overflow:hidden;color:var(--red)}.ribbon>div{font-size:11px;font-weight:500;letter-spacing:.12em;display:flex;align-items:center;gap:58px;white-space:nowrap;animation:marquee 38s linear infinite;will-change:transform}.ribbon span{font-size:24px}.section{max-width:1440px;margin:auto;padding:108px 80px}.section-label{display:flex;align-items:center;gap:35px;font-size:10px;letter-spacing:.13em;color:var(--red)}.tiny-line{height:1px;width:75px;background:var(--line)}.intro h2{font-size:clamp(42px,5vw,76px);line-height:1.1;margin:42px 0 45px;max-width:1070px}.intro h2 i,.menu-heading h2 i,.story-copy h2 i,.space-heading h2 i{color:var(--red)}.intro-bottom{display:grid;grid-template-columns:125px minmax(250px,530px) 1fr;align-items:center;gap:30px}.intro-symbol{width:76px;height:76px;object-fit:contain}.intro-bottom>p{font-size:14px;line-height:1.9;max-width:485px;color:var(--muted)}.text-link{display:inline-flex;align-items:center;gap:27px;font-size:12px;border-bottom:1px solid currentColor;padding-bottom:11px;width:max-content}.text-link svg{width:19px;height:19px;transition:transform .3s}.text-link:hover svg{transform:translateX(5px)}.intro-bottom>.text-link{justify-self:end}.menu-section{padding-top:32px}.menu-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:35px;margin-bottom:46px}.menu-heading h2,.story-copy h2,.space-heading h2{font-size:clamp(48px,5.8vw,86px);line-height:1.03;margin-top:23px}.menu-heading-right{padding-bottom:3px}.menu-heading-right>p{font-size:14px;line-height:1.8;color:var(--muted);margin-bottom:28px}.diet-legend{display:flex;gap:23px;font-size:10px}.diet-legend>span{display:flex;align-items:center;gap:8px}.diet{display:inline-flex;width:13px;height:13px;border:1px solid currentColor;color:#3f704a;align-items:center;justify-content:center;flex-shrink:0}.diet.veg:after{content:'';display:block;width:6px;height:6px;border-radius:50%;background:currentColor}.diet.nonveg{color:#9d392a}.diet.nonveg:after{content:'';width:0;height:0;border-left:3.5px solid transparent;border-right:3.5px solid transparent;border-bottom:6px solid currentColor}.menu-controls{border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:36px}.menu-tabs{display:flex;gap:32px;overflow-x:auto;scrollbar-width:none}.menu-tabs button{border:0;background:transparent;white-space:nowrap;font-size:11px;padding:21px 0;position:relative;color:var(--muted);transition:color .2s}.menu-tabs button sup{font-size:8px;margin-left:4px}.menu-tabs button.active{color:var(--red)}.menu-tabs button.active:after{content:'';position:absolute;bottom:0;left:0;width:100%;height:2px;background:var(--red)}.veg-only{display:flex;align-items:center;gap:9px;white-space:nowrap;font-size:11px;cursor:pointer;position:relative}.veg-only input{position:absolute;opacity:0;width:30px;height:30px;cursor:pointer}.toggle{width:28px;height:16px;border:1px solid #939e8b;border-radius:15px;display:flex;align-items:center;padding:2px;transition:background .2s}.toggle:after{content:'';height:10px;width:10px;border-radius:50%;background:#939e8b;transition:transform .2s,background .2s}.veg-only input:checked+.toggle{background:var(--green);border-color:var(--green)}.veg-only input:checked+.toggle:after{transform:translateX(12px);background:var(--paper)}.veg-only input:focus-visible+.toggle{outline:2px solid var(--red);outline-offset:4px}.menu-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:42px 28px}.menu-card{min-width:0;text-align:left;border:0;border-bottom:1px solid var(--line);padding:0 0 22px;background:transparent;color:var(--ink);transition:transform .5s var(--ease)}.menu-card:hover{transform:translateY(-6px)}.card-image{height:auto;aspect-ratio:1.18;position:relative;overflow:hidden;background:var(--butter)}.card-image img{height:100%;transition:transform .8s var(--ease),filter .8s}.menu-card:hover .card-image img{transform:scale(1.055);filter:saturate(1.06)}.card-tag{position:absolute;top:14px;left:14px;background:var(--paper);padding:7px 10px;font-size:9px;color:var(--ink);z-index:1;display:flex;align-items:center;gap:5px}.card-tag.bestseller{background:var(--butter)}.card-number{position:absolute;right:12px;bottom:12px;color:var(--paper);font-size:9px;letter-spacing:.1em;text-shadow:0 1px 8px #111}.card-meta{display:flex;justify-content:space-between;align-items:center;margin:20px 0 12px;gap:10px}.card-origin{font-size:8px;letter-spacing:.13em;color:var(--muted)}.card-title{display:flex;justify-content:space-between;align-items:baseline;gap:12px}.card-title h3{font-size:26px;line-height:1.15;letter-spacing:-.025em}.card-price{font-family:var(--serif);font-size:22px}.card-description{font-size:11px;color:var(--muted);line-height:1.8;margin-top:10px;min-height:40px;max-width:290px}.card-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:17px;font-size:9px;color:var(--red)}.card-bottom>span{display:flex;align-items:center;gap:6px}.card-bottom svg{width:17px;height:17px}.card-arrow{width:29px;height:29px;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;border-radius:50%;transition:background .3s,border-color .3s,color .3s}.menu-card:hover .card-arrow{background:var(--red);border-color:var(--red);color:var(--paper)}.menu-foot{display:flex;justify-content:space-between;gap:20px;margin-top:30px;font-size:10px;color:var(--muted);line-height:1.7}.menu-foot>span{font-size:8px;letter-spacing:.08em;white-space:nowrap}.menu-empty{padding:50px 0;text-align:center;color:var(--muted)}.story-section{padding-top:28px;display:grid;grid-template-columns:1fr 1fr;gap:10%;align-items:center;padding-bottom:120px}.story-image{position:relative;padding-right:35px}.story-frame{height:580px;overflow:hidden;clip-path:inset(0 0 0 0 round 180px 180px 0 0)}.story-frame img{height:100%;object-position:center 50%;transition:transform 1s var(--ease)}.story-frame:hover img{transform:scale(1.04)}.image-caption{display:block;font-size:8px;letter-spacing:.12em;margin-top:18px}.story-stamp{position:absolute;right:-25px;bottom:60px;background:var(--butter);width:170px;height:170px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-direction:column;transform:rotate(10deg);outline:1px solid var(--butter);outline-offset:7px;text-align:center}.story-stamp>span{font-size:6.5px;letter-spacing:.11em}.story-stamp strong{font-family:var(--serif);font-weight:400;font-size:28px;line-height:.98;margin:15px 0;letter-spacing:-.04em}.story-copy h2{font-size:68px}.story-lead{font-family:var(--serif);font-size:25px;line-height:1.35;letter-spacing:-.02em;margin-top:28px}.story-body{font-size:13px;line-height:1.9;color:var(--muted);margin-top:24px;max-width:425px}.story-values{display:flex;justify-content:space-between;gap:16px;margin:30px 0 32px;padding:25px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.story-values>div{font-size:9px;line-height:1.7}.story-values svg{height:30px;width:30px;display:block;margin-bottom:12px;color:var(--red);stroke-width:1.2}.feast{display:grid;grid-template-columns:1fr 1fr;background:var(--green);color:var(--paper);min-height:630px;margin:0 24px}.feast-photo{overflow:hidden}.feast-photo img{height:100%;max-height:720px;transition:transform 1.5s var(--ease)}.feast:hover .feast-photo img{transform:scale(1.03)}.feast-copy{padding:62px 11%;position:relative;overflow:hidden}.feast h2{font-size:clamp(45px,4.9vw,76px);line-height:1.03;margin:30px 0 28px}.feast h2 i{color:var(--butter)}.feast-copy>p:not(.eyebrow){font-size:12px;color:#dbded0;line-height:1.9;margin-bottom:30px}.feast-flower{position:absolute;right:-10px;bottom:25px;font-size:140px;color:#64745b;opacity:.35;line-height:1;animation:slow-spin 70s linear infinite}.space-section{padding-top:108px;padding-bottom:95px}.space-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:45px;margin-bottom:45px}.space-heading h2{font-size:66px}.space-heading>p{font-size:13px;line-height:1.9;color:var(--muted);padding-bottom:6px}.space-photo{position:relative;height:500px;overflow:hidden}.space-photo>img{height:100%;object-position:50% 70%;transition:transform 1.5s var(--ease)}.space-photo:hover>img{transform:scale(1.035)}.space-photo:after{content:'';position:absolute;inset:30% 0 0;background:linear-gradient(transparent,rgba(10,20,8,.65));pointer-events:none}.space-overlay{position:absolute;left:35px;bottom:32px;color:var(--paper);z-index:1;display:flex;flex-direction:column;gap:14px}.space-overlay>span:first-child{font-size:9px;letter-spacing:.15em}.space-overlay>span:last-child{font-family:var(--serif);font-size:36px;letter-spacing:-.025em}.space-cta{position:absolute;right:35px;bottom:32px;width:60px;height:60px;border:1px solid #f5f1e699;border-radius:50%;color:var(--paper);display:flex;align-items:center;justify-content:center;z-index:1;transition:background .3s,color .3s,transform .3s}.space-cta:hover{background:var(--paper);color:var(--ink);transform:rotate(-35deg)}.space-caption{display:flex;justify-content:space-between;margin-top:19px;color:var(--muted);gap:20px}.space-caption p{font-size:12px}.space-caption>span{font-size:8px;letter-spacing:.12em}.reserve-section{display:grid;grid-template-columns:1fr 1fr;background:var(--green);padding:95px max(7.4%,40px);gap:9%;color:var(--paper)}.reserve-copy h2{font-size:clamp(54px,5.5vw,82px);line-height:1.04;margin:28px 0}.reserve-copy h2 i{color:var(--butter)}.reserve-copy>p:not(.eyebrow){font-size:13px;color:#d3d9ca;line-height:1.9}.reserve-art{margin:35px 0 0;max-width:350px}.reserve-art>span{display:block;font-size:105px;color:var(--butter);height:110px;text-align:center}.table-line{height:1px;background:#b7be9f;position:relative}.table-line:before,.table-line:after{content:'';position:absolute;top:0;width:1px;height:23px;background:#b7be9f}.table-line:before{left:10%}.table-line:after{right:10%}.reserve-art>p{text-align:center;font-size:8px;letter-spacing:.14em;line-height:1.8;margin-top:40px;color:#bcc6b2}.reserve-form-wrap{background:var(--paper);color:var(--ink);padding:30px 35px}.form-top{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:16px;font-size:8px;letter-spacing:.1em;color:var(--red)}.form-top svg{height:30px;width:30px}.reserve-form-wrap h3{font-size:32px;line-height:1.15;margin:28px 0}.form-row{margin-top:21px}.form-row-two{display:grid;grid-template-columns:1fr 1fr;gap:22px}.form-row label{font-size:10px;display:block}.form-row input,.form-row select{margin-top:8px;width:100%;padding:12px 0;border:0;border-bottom:1px solid #a6aa93;background:transparent;color:var(--ink);font-size:12px;border-radius:0;height:43px;min-width:0}.form-row input::placeholder{color:#7b7f6d}.form-row select{cursor:pointer;padding-right:10px}.form-submit{margin-top:31px;width:100%}.form-note{font-size:9px;line-height:1.7;color:var(--muted);text-align:center;margin-top:18px}.faq{display:grid;grid-template-columns:1fr 2fr;gap:7%;padding-top:80px;padding-bottom:80px}.faq>.eyebrow{padding-top:22px}.faq details{border-bottom:1px solid var(--line)}.faq summary{font-family:var(--serif);font-size:25px;letter-spacing:-.025em;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:20px;cursor:pointer;padding:20px 0}.faq summary::-webkit-details-marker{display:none}.faq summary svg{width:18px;height:18px;transition:transform .3s}.faq details[open] summary svg{transform:rotate(45deg)}.faq details>p{font-size:12px;color:var(--muted);line-height:1.9;padding:0 40px 22px 0;max-width:650px}.footer{padding:46px 6% 24px;border-top:1px solid var(--line);overflow:hidden}.footer-top{display:flex;justify-content:space-between;gap:30px;align-items:center}.footer-top>p{font-size:12px;line-height:1.8;color:var(--muted)}.footer .brand>span{font-size:46px}.footer-word{font-family:var(--serif);font-size:clamp(120px,25vw,400px);letter-spacing:-.085em;line-height:.8;color:var(--red);margin:70px 0 46px;display:flex;align-items:center;justify-content:space-between}.footer-word>span{font-family:var(--sans);font-size:.45em;line-height:1;letter-spacing:0;padding:20px 0 0 30px}.footer-bottom{border-top:1px solid var(--line);padding-top:22px;font-size:8px;display:flex;justify-content:space-between;gap:20px;line-height:1.6;color:var(--muted);letter-spacing:.05em}.dish-dialog,.plan-dialog{border:0;padding:0;background:var(--paper);color:var(--ink);max-width:min(860px,calc(100vw - 36px));width:860px;max-height:90svh;overflow:auto}.dish-dialog::backdrop,.plan-dialog::backdrop{background:rgba(14,24,13,.7);backdrop-filter:blur(7px)}dialog[open]{animation:modal-in .35s var(--ease)}.dialog-close{position:absolute;right:14px;top:14px;border:0;background:var(--paper);width:36px;height:36px;display:flex;align-items:center;justify-content:center;border-radius:50%;z-index:2;color:var(--ink)}.dialog-close svg{height:18px;width:18px}.dish-dialog-content{display:grid;grid-template-columns:1fr 1fr}.dish-dialog-photo{height:100%;min-height:480px}.dish-dialog-photo img{height:100%;object-fit:cover}.dish-dialog-copy{padding:50px 35px 35px}.dish-dialog-copy h2{font-size:42px;line-height:1.05;margin:22px 0}.dish-dialog-copy>.description{font-size:13px;color:var(--muted);line-height:1.9}.dish-info{padding:20px 0;margin:20px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;font-size:11px;align-items:center}.dish-info span{display:flex;gap:7px;align-items:center}.dish-info b{font-family:var(--serif);font-weight:400;font-size:27px}.allergen{font-size:10px;color:var(--muted);line-height:1.7;margin-bottom:24px}.plan-dialog{width:560px;padding:36px 40px;text-align:center}.plan-dialog>img{width:62px;height:62px;object-fit:contain;margin:auto auto 24px}.plan-dialog h2{font-size:44px;line-height:1.03;margin:18px 0 25px}.plan-dialog h2 i{color:var(--red)}#plan-details{padding:20px;background:#eae7d9;font-size:13px;line-height:2;margin-bottom:25px}#plan-details strong{display:block;font-family:var(--serif);font-size:24px;font-weight:400}.plan-dialog .button{width:100%}.js .reveal{opacity:0;transform:translateY(25px);transition:opacity .9s var(--ease),transform .9s var(--ease)}.js .reveal.visible{opacity:1;transform:translateY(0)}[hidden]{display:none!important}@keyframes hero-zoom{from{transform:scale(1.075)}to{transform:scale(1)}}@keyframes hero-rise{from{opacity:0;transform:translateY(35px)}to{opacity:1;transform:translateY(0)}}@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-45%)}}@keyframes slow-spin{to{transform:rotate(360deg)}}@keyframes note-float{0%,100%{transform:rotate(10deg) translateY(0)}50%{transform:rotate(6deg) translateY(-8px)}}@keyframes modal-in{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
